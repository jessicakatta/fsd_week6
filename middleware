const express = require('express');
const app = express();
const port = 3000;
app.use((req, res, next) => {
    console.log("Middleware is running");
    next();
});
app.get('/', (req, res) => {
    res.send("Server is running");
});
app.listen(port, () => {
    console.log("Server is running on port 3000");
});
